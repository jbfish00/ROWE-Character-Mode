LilycoveCity_DepartmentStore_4F_EventScript_Gentleman:: @ 821FDEB
	lock
	faceplayer
	msgbox LilycoveCity_DepartmentStore_4F_Text_MegaStoneIntro, MSGBOX_DEFAULT
	message gText_HowMayIServeYou
	waitmessage
	pokemart LilycoveCity_DepartmentStore_4F_Pokemart_MegaStones
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

